# ============================================
# API CONFIGURATION (OBRIGATÓRIO)
# ============================================
# URL base da API (sem /api no final)
# 
# ⚠️ IMPORTANTE PARA PRODUÇÃO (COOLIFY):
# - Use o domínio público do Coolify
# - NÃO use localhost, 127.0.0.1 ou IP interno
# - NÃO adicione /api no final
# - Use HTTPS (Coolify fornece SSL automaticamente)
# 
# ✅ CORRETO:
#   VITE_API_BASE_URL=https://nf-dashboard-homologacao.sistemasflow.com.br
#   VITE_API_BASE_URL=https://seu-dominio.com
# 
# ❌ ERRADO:
#   VITE_API_BASE_URL=http://localhost:3000
#   VITE_API_BASE_URL=https://127.0.0.1:3000
#   VITE_API_BASE_URL=https://seu-dominio.com/api
#   VITE_API_BASE_URL=http://10.0.0.8:3000
# 
# NOTA: Esta variável é usada em BUILD TIME pelo Vite
# Após mudar, você DEVE fazer um novo build completo no Coolify
VITE_API_BASE_URL=https://nf-dashboard-homologacao.sistemasflow.com.br

