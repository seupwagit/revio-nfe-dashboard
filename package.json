{
  "name": "fiscal-system",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Fiscal System Monorepo - NFE Dashboard with DANFE Viewer",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --recursive test:unit",
    "test:integration": "pnpm --recursive test:integration",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headed": "cypress run --headed",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:firefox": "cypress run --browser firefox",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --recursive type-check",
    "clean": "pnpm --recursive clean",
    "validate": "pnpm run validate:config && pnpm run validate:structure && pnpm run validate:files",
    "validate:config": "node -e \"process.platform === 'win32' ? require('child_process').execSync('pwsh -File scripts/validate-project-config.ps1', {stdio: 'inherit'}) : require('child_process').execSync('./scripts/validate-project-config.sh', {stdio: 'inherit'})\"",
    "validate:config:detailed": "node -e \"process.platform === 'win32' ? require('child_process').execSync('pwsh -File scripts/validate-project-config.ps1 -Detailed', {stdio: 'inherit'}) : require('child_process').execSync('./scripts/validate-project-config.sh --detailed', {stdio: 'inherit'})\"",
    "validate:config:json": "node -e \"process.platform === 'win32' ? require('child_process').execSync('pwsh -File scripts/validate-project-config.ps1 -JsonOutput -OutputFile validation-report.json', {stdio: 'inherit'}) : require('child_process').execSync('./scripts/validate-project-config.sh --json --output validation-report.json', {stdio: 'inherit'})\"",
    "validate:structure": "bash scripts/validate-monorepo.sh",
    "validate:files": "bash scripts/validate-file-limits.sh"
  },
  "devDependencies": {
    "@cypress/vite-dev-server": "^7.2.0",
    "cypress": "^15.9.0",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.21.5"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "esbuild"
      ]
    }
  }
}
