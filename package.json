{
  "name": "nf-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "tsc && vite build",
    "build:prod": "tsc --project tsconfig.prod.json && vite build",
    "preview": "vite preview --port 3000 --host",
    "start": "vite preview --port 3000 --host",
    "checktype": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "aggregation": "node scripts/aggregation-server.cjs",
    "mongodb-proxy": "node server/mongodb-proxy.cjs",
    "test-mongodb": "node test-mongodb-connection.cjs",
    "proxy": "node proxy-server.cjs",
    "debug:cache": "node scripts/check-cache.mjs",
    "debug:cache:full": "node scripts/check-cache.mjs --full",
    "debug:cache:clear": "node scripts/check-cache.mjs --clear",
    "debug:monitor": "node scripts/auto-debug-monitor.mjs",
    "debug:monitor:autofix": "node scripts/auto-debug-monitor.mjs --autofix",
    "monitor": "node scripts/auto-monitor.mjs",
    "backend": "npx tsx src/server/index.ts",
    "backend:debug": "npx tsx --inspect=9229 src/server/index.ts",
    "fullstack": "start-fullstack.bat",
    "fullstack:restart": "restart-fullstack.bat",
    "fullstack:rebuild": "rebuild-and-restart.bat",
    "fullstack:debug": "set SERVE_FRONTEND=true&& npx tsx --inspect=9229 src/server/index.ts",
    "kill-ports": "scripts\\kill-ports.bat",
    "docker:build": "docker build -f Dockerfile.fullstack -t nf-dashboard:latest .",
    "docker:build:optimized": "docker build -f Dockerfile.fullstack.optimized -t nf-dashboard:fullstack .",
    "docker:run": "docker run -p 3000:3000 -p 3000:3000 --env-file .env nf-dashboard:latest",
    "docker:run:fullstack": "docker run -p 3000:3000 --env-file .env nf-dashboard:fullstack",
    "docker:compose": "docker-compose up --build",
    "docker:compose:down": "docker-compose down",
    "docker:test": "docker build -f Dockerfile.fullstack -t nf-dashboard:test . && docker run --rm -p 3000:3000 -p 3000:3000 --env-file .env nf-dashboard:test",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "predeploy": "npm run validate:deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.0.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "lucide-react": "^0.441.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.0",
    "prisma": "^7.0.1",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@testcontainers/mongodb": "^11.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fast-check": "^4.3.0",
    "jszip": "^3.10.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.2",
    "vitest": "^4.0.15"
  }
}
