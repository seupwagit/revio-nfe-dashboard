{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🖥️ Debug Backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/src/index.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx/esm"
      ],
      "env": {
        "NODE_ENV": "development",
        "BACKOFFICE_PORT": "4001",
        "PORT": "4001"
      },
      "envFile": "${workspaceFolder}/.env",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "🪟 Clean Backend Build Only"
    },
    {
      "name": "🌐 Debug Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4000",
      "webRoot": "${workspaceFolder}/apps/frontend/src",
      "sourceMaps": true,
      "timeout": 30000,
      "preLaunchTask": "🪟 Start Frontend (Windows Native)"
    },
    {
      "name": "🧪 Debug Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": [
        "run",
        "--reporter=verbose"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "test"
      },
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "🔍 Attach to Backend",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/apps/backend",
      "restart": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "🌐 Start Frontend Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fiscal/frontend", "dev"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development",
        "VITE_PORT": "4000",
        "BACKOFFICE_PORT": "4001"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*http://localhost:4000.*$|^.*ready.*$"
        }
      }
    }
  ],
  "compounds": [
    {
      "name": "🚀 Debug Full Stack",
      "configurations": [
        "🌐 Start Frontend Dev Server",
        "🖥️ Debug Backend"
      ],
      "stopAll": true
    },
    {
      "name": "🌐 Debug Frontend Only",
      "configurations": [
        "🌐 Start Frontend Dev Server",
        "🌐 Debug Frontend"
      ],
      "stopAll": true
    }
  ]
}