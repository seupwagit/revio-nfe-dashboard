# Package Manager Configuration
# This ensures everyone on the team uses the same package manager
package-manager=pnpm@9.0.0

# Registry Configuration
registry=https://registry.npmjs.org/

# Workspace Configuration
# Enable workspace support
enable-pre-post-scripts=true

# Security Settings
# Audit automatically on install
audit-level=moderate

# Performance Settings
# Use hard links when possible to save disk space
node-linker=hoisted

# Strict peer dependencies
strict-peer-dependencies=false

# Auto install peer dependencies
auto-install-peers=true

# Lockfile Settings
# Ensure lockfile is always updated
lockfile=true

# Logging
# Show progress during install
progress=true

# Cache Settings
# Store cache in project directory for better CI performance
store-dir=.pnpm-store

# Monorepo Settings
# Hoist dependencies to root when possible
hoist=true
hoist-pattern[]=*

# Shamefully hoist for compatibility with tools that expect flat node_modules
shamefully-hoist=false

# Development Settings
# Enable dev dependencies in production builds (set to false for production)
production=false

# Network Settings
# Timeout for network requests
network-timeout=60000

# Retry settings
fetch-retries=3
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000