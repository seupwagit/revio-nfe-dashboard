{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@fiscal/shared": ["./packages/shared/src"],
      "@fiscal/shared/*": ["./packages/shared/src/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./apps/frontend" },
    { "path": "./apps/backend" }
  ]
}
