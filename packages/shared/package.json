{
  "name": "@fiscal/shared",
  "version": "1.0.0",
  "description": "Shared types, utilities, and constants for the fiscal system",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage"
  },
  "exports": {
    "./types/manifestation/*": "./dist/types/manifestation/*.js",
    "./types/performance": "./dist/types/performance/index.js",
    "./types/worker-state": "./dist/types/worker-state.interface.js",
    "./dto/*": "./dist/dto/*.js",
    "./schemas/*": "./dist/schemas/*.js",
    "./constants/*": "./dist/constants/*.js",
    "./errors/*": "./dist/errors/*.js",
    "./utils/*": "./dist/utils/*.js"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/node": "^20.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}