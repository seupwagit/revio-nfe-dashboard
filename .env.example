# Exemplo de Configuração de Variáveis de Ambiente
# Copie este arquivo para .env.local e configure os valores apropriados

# =============================================================================
# 🌐 APIs e URLs
# =============================================================================

# URL base do backend da aplicação
VITE_API_BASE_URL=http://localhost:3001

# URL da API externa da Revio para consultas NFe
VITE_EXTERNAL_API_URL=http://apinfe.revio.digital/api

# URL da API pública da Revio
VITE_REVIO_API_URL=https://api.revio.com.br/api/v1

# URL base da API do Google Gemini (para busca natural)
VITE_GOOGLE_API_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================================================
# 🔐 Autenticação
# =============================================================================

# Token de autenticação para APIs externas
VITE_API_BEARER_TOKEN=seu_token_aqui

# =============================================================================
# 🌐 CORS e Frontend
# =============================================================================

# URL do frontend (para configuração CORS no backend)
FRONTEND_URL=https://seu-dominio.com

# Origem CORS personalizada (alternativa ao FRONTEND_URL)
CORS_ORIGIN=https://seu-dominio.com

# =============================================================================
# 🗄️ Base de Dados
# =============================================================================

# Host da base de dados
VITE_DB_HOST=localhost

# Nome da base de dados
VITE_DB_DATABASE=revio_nfe

# Collection/tabela padrão
VITE_DB_COLLECTION=tbl_nfe_100

# =============================================================================
# ⚙️ Configurações Padrão
# =============================================================================

# Tamanho padrão de página para listagens
VITE_DEFAULT_PAGE_SIZE=500

# Página inicial padrão
VITE_DEFAULT_PAGE=1

# Máximo de dias permitido em filtros de data
VITE_MAX_DATE_RANGE_DAYS=365

# Tamanho de página para analytics
VITE_ANALYTICS_PAGE_SIZE=10000

# =============================================================================
# 📝 Exemplos para Diferentes Ambientes
# =============================================================================

# DESENVOLVIMENTO LOCAL
# VITE_API_BASE_URL=http://localhost:3001
# VITE_EXTERNAL_API_URL=http://apinfe.revio.digital/api

# STAGING/TESTE
# VITE_API_BASE_URL=https://api-staging.sua-empresa.com
# VITE_EXTERNAL_API_URL=http://apinfe-test.revio.digital/api

# PRODUÇÃO
# VITE_API_BASE_URL=https://api.sua-empresa.com
# VITE_EXTERNAL_API_URL=https://apinfe.revio.digital/api