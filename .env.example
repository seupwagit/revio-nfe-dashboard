# API Configuration
# ⚠️ IMPORTANTE: Não incluir /api na base URL (é adicionado automaticamente no código)
# 
# Estrutura da URL:
#   Base URL:    https://apinfe.revio.digital
#   API Path:    /api (adicionado automaticamente)
#   Controller:  /WebView
#   Route:       /Consultar
#   URL Final:   https://apinfe.revio.digital/api/WebView/Consultar
#
VITE_API_BASE_URL=https://apinfe.revio.digital
VITE_API_BEARER_TOKEN=seu_token_aqui

# Alternativas de API:
# 1. API Direta HTTPS (recomendado): https://apinfe.revio.digital
# 2. API Direta HTTP: http://apinfe.revio.digital
# 3. Proxy Local (para desenvolvimento): http://localhost:3001

# Database Configuration
VITE_DB_HOST=10.0.0.8
VITE_DB_DATABASE=C67624577000145  # Identificador do banco de dados (não é um CNPJ)
VITE_DB_COLLECTION=tbl_nfe_100

# Default Query Parameters
# API aceita até 20.000, mas 10.000 é o ideal para performance
VITE_DEFAULT_PAGE_SIZE=10000
VITE_DEFAULT_PAGE=1

# Date Range Configuration
# ⚠️ IMPORTANTE: Períodos > 60 dias podem causar timeout
# ✅ Recomendado: 30 dias (padrão)
# ⚠️ Máximo seguro: 60 dias
# ❌ Evitar: 90+ dias (usar agregação mensal)
VITE_MAX_DATE_RANGE_DAYS=60
VITE_DEFAULT_DATE_RANGE_DAYS=30

# MongoDB Direct Connection (READ-ONLY para agregações e totalizadores)
# ⚠️ ATENÇÃO: NUNCA usar para DELETE, UPDATE ou INSERT
# ⚠️ Usar APENAS para consultas agregadas (SUM, COUNT, GROUP BY, etc)
# ⚠️ Ideal para gráficos e dashboards que não precisam de drill-down
VITE_MONGODB_CONNECTION_STRING=mongodb://revio:zaqwsx2001@10.0.0.8:27017/?authMechanism=SCRAM-SHA-256&directConnection=true

# Frontend Port Configuration
# Port used by Vite development and preview servers
# Default: 3000 (Coolify compatible)
VITE_PORT=3000

# Wasabi S3 Configuration
# Object storage for fiscal document XML files
VITE_S3_ENDPOINT=https://s3.wasabisys.com
VITE_S3_ACCESS_KEY=7YDC7UG085G6BS8A714S
VITE_S3_SECRET_KEY=HYKatJ4XbvaOsCsz9uJJGm2ZBgZWfsgZ5XHun1Vs
VITE_S3_BUCKET=revio-bucket
VITE_S3_REGION=us-east-1

# SQL Server Configuration
# Used for scheduled download records
VITE_DB_SERVER=10.0.0.4
VITE_DB_USER=sa
VITE_DB_PASSWORD=zaqwsx2001
# VITE_DB_DATABASE is already defined above as C67624577000145
